{
  "name": "Hugo Blox - Academic CV",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "HUGO_VERSION": "0.162.0"
    }
  },
  "forwardPorts": [1313],
  "portsAttributes": {
    "1313": {
      "label": "Hugo Local Server",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rustydev.hugo-vscode",
        "redhat.vscode-yaml",
        "davidanson.vscode-markdownlint"
      ]
    }
  },
  // Navega a la subcarpeta hugo26 donde está tu package.json antes de ejecutar npm install
  "postCreateCommand": "cd hugo26 && npm install --no-audit"
}